    <dict><key>PATH</key><string>__PATH__</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>__REPO__/data/ui.log</string>
    <key>StandardErrorPath</key><string>__REPO__/data/ui.log</string>

# GitLab（建议使用单独的 bot 账号的 Personal Access Token，权限 api）
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

# 本地模型（OpenAI 兼容接口：LM Studio 默认 1234 端口，mlx_lm.server 为自定义端口）
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=local
LLM_MODEL=qwen3.6-35b-a3b-gguf-switch
# 复核/验证用模型，不填则与 LLM_MODEL 相同（可换成 qwen3-30b-a3b-thinking-2507）
LLM_VERIFY_MODEL=
# 审查不思考、复核思考（依赖 switch 模板识别 system 中的 /no_think）
LLM_REVIEW_NO_THINK=true
LLM_VERIFY_NO_THINK=false
# json_schema: 服务端支持 response_format（LM Studio）；text: 提示词约束 + 本地解析（mlx_lm.server）
LLM_STRUCTURED_MODE=json_schema
